# ==============================================================================
# BPMN ARCHITECT SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# Example: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & SERVICE BINDINGS
# ------------------------------------------------------------------------------
# Host address to bind the service to (0.0.0.0 listens on all interfaces)
SERVICE_HOST=0.0.0.0

# TCP Port for the service
SERVICE_PORT=8001

# Subdirectory root path if running behind a reverse proxy (e.g. /api/bpmn)
# Leave empty ("") if running at root domain
SERVICE_ROOT_PATH=

# Allowed CORS Origins (comma-separated). Set to "*" for open intranet access,
# or specify the URL of your static frontend (e.g. http://intranet.local:8080)
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. STORAGE & SIZE LIMITS
# ------------------------------------------------------------------------------
# Absolute or relative directory path where .bpmn, .svg and .json files are stored.
# If IIS or Nginx hosts this directory statically, files remain accessible even
# if this Python service is stopped.
STORAGE_DIR=../diagram_storage

# Maximum permitted payload size in Megabytes for incoming BPMN XML or SVG files.
# Prevents memory exhaustion / Denial-of-Service attacks.
MAX_PAYLOAD_SIZE_MB=5

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Authentication method to enforce:
# - "none"        : Open mode (useful for local development/testing)
# - "master-key"  : Shared secret header (X-Master-Key or Bearer token)
# - "iis-header"  : Reverse proxy identity header (e.g. X-Forwarded-User from IIS Windows Auth)
# - "ldap"        : LDAP / Active Directory bind with group-based admin check
AUTH_METHOD=master-key

# Master Secret Key (used when AUTH_METHOD=master-key)
MASTER_KEY=change-this-to-a-secure-master-key-in-production

# IIS / Reverse Proxy Header Settings (used when AUTH_METHOD=iis-header)
# The HTTP header injected by IIS ARR / Windows Authentication
IIS_HEADER_NAME=X-Forwarded-User

# Comma-separated list of DOMAIN\username or usernames who receive ADMIN privileges.
# Non-admin users who authenticate successfully receive standard EDITOR privileges.
IIS_ADMIN_USERS=CORP\administrator,CORP\bpm_admin,admin

# LDAP / Active Directory Settings (used when AUTH_METHOD=ldap)
# Server connection URL (use ldaps:// for SSL/TLS encrypted traffic)
LDAP_SERVER_URL=ldap://127.0.0.1:389

# Service account used to bind and perform directory searches
LDAP_BIND_DN=CN=ServiceAccount,OU=ServiceAccounts,DC=company,DC=local
LDAP_BIND_PASSWORD=SecretServicePassword

# Base DN where user accounts are located
LDAP_BASE_DN=DC=company,DC=local

# LDAP query filter template for user lookup ({username} is replaced dynamically)
LDAP_USER_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={username}))

# Distinguished Name (DN) of the Active Directory Group that grants ADMIN rights.
# Members of this group are admins; all other authenticated LDAP users are editors.
LDAP_ADMIN_GROUP_DN=CN=BPMN_Admins,OU=Groups,DC=company,DC=local

# ------------------------------------------------------------------------------
# 4. COOPERATIVE LOCK & SESSION TIMINGS
# ------------------------------------------------------------------------------
# Expected frequency in seconds for clients to send heartbeats while actively editing.
LOCK_HEARTBEAT_SEC=15

# Additional grace period in seconds added to the lock expiry to handle minor network jitter.
LOCK_EXPIRY_PAD_SEC=15

# Minutes of user inactivity after which an edit lock automatically expires.
IDLE_TIMEOUT_MIN=15

